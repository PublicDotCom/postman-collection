		{
			"name": "Order Placement",
			"item": [
				{
					"name": "Preflight single leg",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Get the current date and time",
									"let now = new Date();",
									"",
									"// Add 24 hours (in milliseconds)",
									"let expirationDate = new Date(now.getTime() + 24 * 60 * 60 * 1000);",
									"",
									"// Convert to ISO string (UTC)",
									"let expirationISO = expirationDate.toISOString();",
									"",
									"// Set it as an environment or local variable",
									"pm.environment.set(\"expirationTime\", expirationISO);"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}",
								"type": "text"
							}
						],
